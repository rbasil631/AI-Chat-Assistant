# --- Server ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-chat-assistant
CORS_ORIGIN=http://localhost:5173

# --- AI provider ---
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# --- Chat limits ---
MAX_PROMPT_CHARS=8000
CONTEXT_EXCHANGES=12
CONTEXT_CHAR_BUDGET=24000
RATE_LIMIT_MAX=30
